---
// src/components/Navbar.astro
import { t } from "../i18n/ui.js";

const pathname = Astro.url.pathname;
const lang = pathname.includes("/en")
  ? "en"
  : pathname.includes("/de")
    ? "de"
    : pathname.includes("/fr")
      ? "fr"
      : "es";
const textos = t[lang] || t["es"];

const idiomasDisponibles = [
  {
    codigo: "es",
    urlBandera: "https://flagcdn.com/w20/es.png",
    nombre: "Español",
  },
  {
    codigo: "en",
    urlBandera: "https://flagcdn.com/w20/gb.png",
    nombre: "English",
  },
  {
    codigo: "de",
    urlBandera: "https://flagcdn.com/w20/de.png",
    nombre: "Deutsch",
  },
  {
    codigo: "fr",
    urlBandera: "https://flagcdn.com/w20/fr.png",
    nombre: "Français",
  },
];

const idiomaActual =
  idiomasDisponibles.find((i) => i.codigo === lang) || idiomasDisponibles[0];

const getUrlParaIdioma = (codigoDestino) => {
  return pathname.replace(`/${lang}`, `/${codigoDestino}`);
};
---

<header class="sticky top-0 z-50 shadow-lg w-full">
  <!-- Franja Amarilla (Solo PC) -->
  <div class="hidden lg:flex bg-amarillo-acento text-azul-oscuro py-2 px-6">
    <div class="max-w-7xl mx-auto w-full flex justify-between items-center text-sm xl:text-base font-bold">
      <div class="flex gap-6">
        <a href="https://www.padelaguilas.club" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Padel</a>
        <a href="https://www.aguilas.golf" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Golf</a>
      </div>
      <div class="flex gap-6 items-center">
        <a href={`/${lang}/blog/`} class="hover:text-white transition-colors">
          {textos["nav.blog"] || "Blog"}
        </a>
        <div class="flex gap-4 items-center">
          <a href="https://www.facebook.com/share/1EQr66LV4i/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
          </a>
          <a href="https://www.instagram.com/pickleball_aguilas?igsh=azcybGh3YjZmbnUy" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <nav class="bg-azul-oscuro text-white py-4 px-6 relative">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href={`/${lang}/`} class="flex items-center gap-3 z-20 group">
        <img
          src="/logo-pickleball-amarillo.png"
          alt="Logo Pickleball Águilas Resort"
          class="w-14 md:w-20 h-auto object-contain shrink-0"
        />
      </a>

      <div
        class="hidden lg:flex items-center gap-6 font-medium text-sm xl:text-base lg:absolute lg:left-1/2 lg:-translate-x-1/2"
      >
        <a
          href={`/${lang}/instalaciones/`}
          class="hover:text-amarillo-acento transition-colors"
        >
          {textos["nav.instalaciones"]}
        </a>

        <a
          href={`/${lang}/articulos/`}
          class="hover:text-amarillo-acento transition-colors"
        >
          {textos["nav.articulos"]}
        </a>

        <a
          href={`/${lang}/reglasfaciles/`}
          class="hover:text-amarillo-acento transition-colors"
        >
          {textos["nav.reglas"] || "Reglas"}
        </a>

        <a
          href={`/${lang}/contacto/`}
          class="hover:text-amarillo-acento transition-colors"
        >
          {textos["nav.contacto"]}
        </a>
      </div>

    <div class="flex items-center gap-2 sm:gap-4 z-20">
      <div class="relative">
        <button
          id="btn-idioma"
          class="flex items-center gap-1.5 px-2 py-1 rounded hover:bg-white/10 transition-colors cursor-pointer"
        >
          <img
            src={idiomaActual.urlBandera}
            alt={idiomaActual.nombre}
            class="w-5 h-auto rounded-sm shadow-sm"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-70"><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>

        <div
          id="menu-idioma"
          class="absolute right-0 mt-2 w-36 bg-white rounded-md shadow-xl py-1 opacity-0 invisible transition-all duration-200 z-50 transform origin-top-right scale-95"
        >
          {
            idiomasDisponibles.map((idioma) => (
              <a
                href={getUrlParaIdioma(idioma.codigo)}
                class={`flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-gray-100 hover:text-azul-principal transition-colors ${lang === idioma.codigo ? "text-azul-principal font-bold bg-blue-50" : "text-gray-700"}`}
              >
                <img
                  src={idioma.urlBandera}
                  alt={idioma.nombre}
                  class="w-5 h-auto rounded-sm shadow-sm"
                />
                {idioma.nombre}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href="https://app.sporttia.com/scs/3287/profile"
        target="_blank"
        class="hidden lg:inline-block bg-amarillo-acento text-azul-oscuro font-bold px-4 xl:px-5 py-2 text-sm xl:text-base rounded shadow-md hover:bg-yellow-400 hover:scale-105 transition-all whitespace-nowrap uppercase"
      >
        {textos["nav.reserva"]}
      </a>

      <button
        id="btn-menu"
        class="lg:hidden flex items-center justify-center p-2 rounded text-white hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Abrir menú"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="4" x2="20" y1="12" y2="12"></line><line
            x1="4"
            x2="20"
            y1="6"
            y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
        >
      </button>
    </div>
  </div>

  <div
    id="menu-movil"
    class="hidden lg:hidden mt-4 pt-4 border-t border-white/10 flex-col gap-5 font-medium pb-4 px-2"
  >
    <!-- 
    <a
      href={`/${lang}/`}
      class="block hover:text-amarillo-acento transition-colors text-lg"
    >
      {textos["nav.inicio"]}
    </a>
     -->
    <a
      href={`/${lang}/instalaciones/`}
      class={`block hover:text-amarillo-acento transition-colors text-lg ${pathname.includes("/instalaciones") ? "text-amarillo-acento font-bold" : ""}`}
    >
      {textos["nav.instalaciones"]}
    </a>

    <a
      href={`/${lang}/articulos/`}
      class={`block hover:text-amarillo-acento transition-colors text-lg ${pathname.includes("/articulos") ? "text-amarillo-acento font-bold" : ""}`}
    >
      {textos["nav.articulos"]}
    </a>

    <a
      href={`/${lang}/reglasfaciles/`}
      class={`block hover:text-amarillo-acento transition-colors text-lg ${pathname.includes("/reglasfaciles") ? "text-amarillo-acento font-bold" : ""}`}
    >
      {textos["nav.reglas"] || "Reglas"}
    </a>

    <a
      href="https://www.padelaguilas.club"
      target="_blank"
      rel="noopener noreferrer"
      class="block hover:text-amarillo-acento transition-colors text-lg"
      >Padel</a
    >
    <a
      href="https://www.aguilas.golf"
      target="_blank"
      rel="noopener noreferrer"
      class="block hover:text-amarillo-acento transition-colors text-lg">Golf</a
    >
    <a
      href={`/${lang}/blog/`}
      class={`block hover:text-amarillo-acento transition-colors text-lg ${pathname.includes("/blog") ? "text-amarillo-acento font-bold" : ""}`}
    >
      {textos["nav.blog"]}
    </a>
    <a
      href={`/${lang}/contacto/`}
      class={`block hover:text-amarillo-acento transition-colors text-lg ${pathname.includes("/contacto") ? "text-amarillo-acento font-bold" : ""}`}
    >
      {textos["nav.contacto"]}
    </a>

    <a
      href="https://app.sporttia.com/scs/3287/profile"
      target="_blank"
      class="mt-2 bg-amarillo-acento text-azul-oscuro font-bold px-4 py-3 rounded text-center shadow-md hover:bg-yellow-400 transition-colors uppercase w-full"
    >
      {textos["nav.reserva"]}
    </a>
  </div>
</nav>
</header>

<script>
  const initNavInteractions = () => {
    const btnMenu = document.getElementById("btn-menu");
    const menuMovil = document.getElementById("menu-movil");
    const btnIdioma = document.getElementById("btn-idioma");
    const menuIdioma = document.getElementById("menu-idioma");

    if (btnMenu && menuMovil) {
      btnMenu.onclick = (e) => {
        e.stopPropagation();
        menuMovil.classList.toggle("hidden");
        menuMovil.classList.toggle("flex");

        if (menuIdioma) {
          menuIdioma.classList.add("opacity-0", "invisible", "scale-95");
          menuIdioma.classList.remove("scale-100");
        }
      };
    }

    if (btnIdioma && menuIdioma) {
      btnIdioma.onclick = (e) => {
        e.stopPropagation();
        menuIdioma.classList.toggle("opacity-0");
        menuIdioma.classList.toggle("invisible");
        menuIdioma.classList.toggle("scale-95");
        menuIdioma.classList.toggle("scale-100");
      };
    }

    document.addEventListener("click", (e) => {
      if (
        menuIdioma &&
        !menuIdioma.contains(e.target as Node) &&
        !btnIdioma?.contains(e.target as Node)
      ) {
        menuIdioma.classList.add("opacity-0", "invisible", "scale-95");
        menuIdioma.classList.remove("scale-100");
      }
    });
  };

  initNavInteractions();
  document.addEventListener("astro:page-load", initNavInteractions);
</script>
