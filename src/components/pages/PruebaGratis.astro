---
// src/components/PruebaGratis.astro
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import { t } from "../../i18n/ui.js";

const { lang } = Astro.props;
const textos = t[lang];
---

<Layout title={textos["free.head_title"]} lang={lang}>
    <Navbar />

    <header
        class="relative bg-azul-oscuro py-20 px-6 flex flex-col items-center text-center overflow-hidden"
    >
        <div
            class="absolute inset-0 bg-gradient-to-b from-black/50 to-black/20 z-10"
        >
        </div>
        <img
            src="/imagen-fondo2.jpg"
            alt="Fondo pistas de Pickleball"
            class="absolute inset-0 w-full h-full object-cover z-0 opacity-40"
        />
        <div class="relative z-20 max-w-3xl mx-auto">
            <span
                class="text-amarillo-acento font-bold uppercase tracking-widest text-sm mb-3 block"
            >
                {textos["free.badge"]}
            </span>
            <h1
                class="font-titulos text-4xl md:text-5xl text-white uppercase italic shadow-sm mb-4"
            >
                {textos["free.hero_title"]}
            </h1>
            <p class="text-gray-200 text-lg">
                {textos["free.hero_desc"]}
            </p>
        </div>
    </header>

    <main class="py-16 md:py-24 px-6 bg-gray-50 flex justify-center">
        <div
            class="w-full max-w-lg bg-white rounded-2xl shadow-xl overflow-hidden border-t-4 border-amarillo-acento"
        >
            <div class="p-8">
                <div id="form-container">
                    <h2
                        class="text-2xl font-bold text-azul-oscuro mb-6 text-center"
                    >
                        {textos["free.form_title"]}
                    </h2>

                    <form id="prueba-form" class="space-y-5">
                        <div>
                            <label
                                for="nombre"
                                class="block text-sm font-medium text-gray-700 mb-1"
                                >{textos["free.label_name"]}</label
                            >
                            <input
                                type="text"
                                id="nombre"
                                name="nombre"
                                required
                                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-amarillo-acento focus:border-amarillo-acento outline-none transition-colors"
                                placeholder={textos["free.place_name"]}
                            />
                        </div>

                        <div>
                            <label
                                for="correo"
                                class="block text-sm font-medium text-gray-700 mb-1"
                                >{textos["free.label_email"]}</label
                            >
                            <input
                                type="email"
                                id="correo"
                                name="correo"
                                required
                                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-amarillo-acento focus:border-amarillo-acento outline-none transition-colors"
                                placeholder={textos["free.place_email"]}
                            />
                        </div>

                        <div>
                            <label
                                for="telefono"
                                class="block text-sm font-medium text-gray-700 mb-1"
                                >{textos["free.label_phone"]}</label
                            >
                            <input
                                type="tel"
                                id="telefono"
                                name="telefono"
                                required
                                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-amarillo-acento focus:border-amarillo-acento outline-none transition-colors"
                                placeholder={textos["free.place_phone"]}
                            />
                        </div>

                        <button
                            type="submit"
                            id="btn-submit"
                            class="w-full bg-azul-oscuro text-white font-bold py-3 px-4 rounded-lg hover:bg-blue-900 transition-colors mt-4 flex justify-center items-center"
                        >
                            <span>{textos["free.btn_submit"]}</span>
                            <svg
                                id="spinner"
                                class="animate-spin ml-2 h-5 w-5 text-white hidden"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                            >
                                <circle
                                    class="opacity-25"
                                    cx="12"
                                    cy="12"
                                    r="10"
                                    stroke="currentColor"
                                    stroke-width="4"></circle>
                                <path
                                    class="opacity-75"
                                    fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                                ></path>
                            </svg>
                        </button>
                    </form>
                    <p
                        id="error-msg"
                        class="text-red-500 text-sm mt-4 text-center hidden"
                    >
                        {textos["free.error_msg"]}
                    </p>
                </div>

                <div id="success-container" class="hidden text-center py-6">
                    <div
                        class="w-16 h-16 bg-green-100 text-green-500 rounded-full flex items-center justify-center mx-auto mb-4"
                    >
                        <svg
                            class="w-8 h-8"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-azul-oscuro mb-2">
                        {textos["free.success_title"]}
                    </h2>
                    <p class="text-gray-600 mb-6">
                        {textos["free.success_desc"]}
                    </p>

                    <div
                        class="bg-blue-50 border border-blue-100 rounded-xl p-5"
                    >
                        <p class="font-medium text-azul-oscuro mb-3">
                            {textos["free.wa_text"]}
                        </p>
                        <a
                            href="https://chat.whatsapp.com/FeCwMiKxQ5n1H9NRyXaNaw"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center bg-[#25D366] text-white font-bold py-3 px-6 rounded-lg hover:bg-green-600 transition-colors w-full"
                        >
                            <svg
                                class="w-6 h-6 mr-2"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
                                ></path>
                            </svg>
                            {textos["free.wa_btn"]}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <Footer lang={lang} />
</Layout>

<script>
    const form = document.getElementById("prueba-form") as HTMLFormElement;
    const formContainer = document.getElementById("form-container");
    const successContainer = document.getElementById("success-container");
    const btnSubmit = document.getElementById(
        "btn-submit",
    ) as HTMLButtonElement;
    const spinner = document.getElementById("spinner");
    const errorMsg = document.getElementById("error-msg");

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (errorMsg) errorMsg.classList.add("hidden");
            if (btnSubmit) btnSubmit.disabled = true;
            if (spinner) spinner.classList.remove("hidden");

            const formData = new FormData(form);

            try {
                const response = await fetch("/db_php/guardar_prueba.php", {
                    method: "POST",
                    body: formData,
                });

                if (response.ok) {
                    if (formContainer) formContainer.classList.add("hidden");
                    if (successContainer)
                        successContainer.classList.remove("hidden");
                } else {
                    throw new Error("Error en el servidor");
                }
            } catch (error) {
                console.error("Error:", error);
                if (errorMsg) errorMsg.classList.remove("hidden");
            } finally {
                if (btnSubmit) btnSubmit.disabled = false;
                if (spinner) spinner.classList.add("hidden");
            }
        });
    }
</script>
